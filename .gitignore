# Python byte-code / cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Packaging / build artifacts
*.egg-info/
dist/
build/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Saved pages used as parser fixtures — someone else's HTML, not ours to
# redistribute. Tests that need them skip when they are absent.
tests/fixtures/*.html

# Media test fixtures / scratch libraries (never track real or synthetic rips)
*.mkv
*.mp4
test_library/
scratch/

# sort2own manifest (should only ever live in a destination library, never the repo)
.sort2own.json

# Claude Code local state (per-machine settings, runtime lock)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Editor / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
